generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String?
  email             String    @unique
  password          String?
  subscriptionStatus SubscriptionStatus @default(FREE)
  stripeCustomerId  String?   @unique
  trialEndsAt       DateTime?              // 5-day trial expiration
  createdAt         DateTime  @default(now())
  stats             UserStats?
  favorites         Favorite[]
}

model UserStats {
  id             Int     @id @default(autoincrement())
  user           User    @relation(fields: [userId], references: [id])
  userId         Int     @unique
  focusSessions  Int     @default(0)
  minutesFocused Int     @default(0)
  streakCount    Int     @default(0)
  completedDates Json    @default("[]")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  type      FavoriteType
  itemId    String
  createdAt DateTime @default(now())
}

enum SubscriptionStatus {
  FREE
  TRIAL
  ACTIVE
  CANCELLED
}

enum FavoriteType {
  AFFIRMATION
  SOUND
}
