# API environment variables - example

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aura?schema=public

# JWT
JWT_SECRET=replace-with-strong-secret

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# Stripe
